# Sigma Sync configuration - copy to /data/AAP_Storage/secrets/sigmasync.env
# (outside the app tree), owned root:apache, mode 640. Never commit real values.

# --- Database (per-app MariaDB user over TCP) ---
DB_HOST=127.0.0.1
DB_NAME=sigmasync
DB_USER=sigmasync_app
DB_PASSWORD=change-me

# --- Encryption at rest ---
# 32 random bytes as 64 hex characters:  openssl rand -hex 32
# Keep a copy somewhere safe: without it the stored payloads, titles, descriptions and
# comments cannot be decrypted (including from backups).
DATA_KEY=

# --- Access ---
# Anyone can sign in with an Ergo wallet; they only see transactions their keys sign for.
# Comma-separated wallet (P2PK) addresses that are always admins (can disable accounts and
# read the audit log; admins get NO extra access to transactions).
ADMIN_ADDRESSES=

# Maximum transactions one account may start per 24 hours (spam guard).
DAILY_TX_LIMIT=20

# mainnet or testnet
NETWORK=mainnet

# --- Sessions ---
# Sign-in lasts 2 days (absolute), and also ends after 2 days without activity.
# Signing in with an air-gapped wallet is slow, so sessions are long.
SESSION_HOURS=48
SESSION_IDLE_MINUTES=2880
CHALLENGE_MINUTES=15
COOKIE_PATH=/apps/sigmasync/
# 1 in production (HTTPS). Only set 0 for local development over plain HTTP.
COOKIE_SECURE=1

# --- Locks ---
# Distinct signers (other than the lock holder) needed to force-unlock a forgotten lock,
# and how long a lock must be held before override votes are accepted.
UNLOCK_VOTES=2
UNLOCK_GRACE_MINUTES=10

# --- Explorer links ---
EXPLORER_TX_URL=https://explorer.ergoplatform.com/en/transactions/
EXPLORER_API_URL=https://api.ergoplatform.com/api/v1/transactions/
EXPLORER_TOKEN_API_URL=https://api.ergoplatform.com/api/v1/tokens/
EXPLORER_ADDRESS_URL=https://explorer.ergoplatform.com/en/addresses/
