# Sigma Sync configuration - copy to /data/AAP_Storage/secrets/sigmasync.env
# (outside the app tree), owned root:apache, mode 640. Never commit real values.

# --- Database (per-app MariaDB user over TCP) ---
DB_HOST=127.0.0.1
DB_NAME=sigmasync
DB_USER=sigmasync_app
DB_PASSWORD=change-me

# --- Encryption at rest ---
# 32 random bytes as 64 hex characters:  openssl rand -hex 32
# Keep a copy somewhere safe: without it the stored payloads, titles, descriptions and
# comments cannot be decrypted (including from backups).
DATA_KEY=

# --- Access ---
# Comma-separated wallet (P2PK) addresses that are always admins. They are created as
# members on first sign-in; everyone else is added from the Signers tab.
ADMIN_ADDRESSES=

# mainnet or testnet
NETWORK=mainnet

# --- Sessions ---
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120
CHALLENGE_MINUTES=15
COOKIE_PATH=/apps/sigmasync/
# 1 in production (HTTPS). Only set 0 for local development over plain HTTP.
COOKIE_SECURE=1

# --- Locks ---
# Distinct signers (other than the lock holder) needed to force-unlock a forgotten lock,
# and how long a lock must be held before override votes are accepted.
UNLOCK_VOTES=2
UNLOCK_GRACE_MINUTES=10

# --- Explorer links ---
EXPLORER_TX_URL=https://explorer.ergoplatform.com/en/transactions/
EXPLORER_API_URL=https://api.ergoplatform.com/api/v1/transactions/
